# Everyone brings their own key through the UI, so a deployed instance needs
# none of this. Set them only for local development.

# ALLOW_SERVER_KEY=1 lets the server's own key stand in when the UI sends none.
# Leave it unset on any public deployment, or visitors spend your credits.
# ALLOW_SERVER_KEY=1
# TYPESAFE_API_KEY=

# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_SCREEN_TIMEOUT_MS=5000
